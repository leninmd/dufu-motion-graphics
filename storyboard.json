  "narration": [
    { "id": "n1", "start": 4.20,  "text": "七一二年，他生在巩县。二十四岁登上泰山，以为这一生会很长，盛世会更长。", "voice": "zh-CN-YunjianNeural", "rate": "-8%", "pitch": "-2Hz" },
    { "id": "n2", "start": 14.30, "text": "四十四岁，天下大乱。他丢了官，丢了家，在成都的秋风里，他写下，安得广厦千万间。", "voice": "zh-CN-YunjianNeural", "rate": "-8%", "pitch": "-2Hz" },
    { "id": "n3", "start": 24.70, "text": "他一路往南，秦州，同谷，成都，夔州。三峡的秋天，无边落木萧萧下。", "voice": "zh-CN-YunjianNeural", "rate": "-6%", "pitch": "-2Hz" },
    { "id": "n4", "start": 34.60, "text": "烽火连三月，家书抵万金。后来，他连家书也等不到了。一条船，一家人，在湘江上漂了两年。", "voice": "zh-CN-YunjianNeural", "rate": "-8%", "pitch": "-2Hz" },
    { "id": "n5", "start": 47.30, "text": "他一生走了四千七百公里，留下一千四百多首诗。", "voice": "zh-CN-YunjianNeural", "rate": "-8%", "pitch": "-2Hz" },
    { "id": "n6", "start": 56.10, "text": "如果有一天，你的人生突然崩塌。你会怎么办？", "voice": "zh-CN-YunjianNeural", "rate": "-6%", "pitch": "-3Hz" },
    { "id": "n7", "start": 64.60, "text": "杜甫把一手烂牌，打成了诗史。", "voice": "zh-CN-YunjianNeural", "rate": "-8%", "pitch": "-2Hz" },
    { "id": "n8", "start": 70.30, "text": "七七〇年冬，湘江，一条小船。他五十九岁。最后一句：战血流依旧，军声动至今。", "voice": "zh-CN-YunjianNeural", "rate": "-7%", "pitch": "-3Hz" },
    { "id": "n9", "start": 79.95, "text": "他没能致君尧舜上，却把整个时代，写成了诗。", "voice": "zh-CN-YunjianNeural", "rate": "-10%", "pitch": "-3Hz" }
  ]
}
